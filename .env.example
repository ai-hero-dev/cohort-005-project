# Copy to .env. Every value here is optional — the app boots, and every page
# works, with none of them set.

# Ably carries an in-app notification out of the app, so somebody who is not
# looking at Cadence still hears about it. Leave it unset and the bridge is
# simply off: notifications are still written to the database and the bell
# still shows them.
#
# Get one from https://ably.com/accounts → your app → API Keys. The key needs
# the "publish" capability on the `notifications:*` channels and nothing else.
ABLY_API_KEY=

# The invite shown on a course's welcome page. Unset means no invite is shown.
DISCORD_INVITE_URL=
